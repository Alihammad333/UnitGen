# ------------------------------------------------------------------------------
# UNITGEN WEBSITE ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to '.env' and populate with actual credentials.
# Do NOT commit '.env' to git history.
# ------------------------------------------------------------------------------

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/unitgen

# GitHub Releases Download Endpoint Prefix
GITHUB_RELEASES_BASE_URL=https://github.com/<username>/UnitGen/releases/download
